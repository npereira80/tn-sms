# Copy to .env and adjust. The server reads these at startup.
PORT=8787
# Directory for the SQLite DB and media (created if missing).
DATA_DIR=./data
# Shared bootstrap secret required to register a new device. Rotate as needed.
REGISTRATION_SECRET=change-me-to-a-long-random-string

# Read ONCE, on the first start after upgrading a single-user install: the email
# the existing data/sms.sqlite is adopted under. Set it before that first start.
# Left unset, the account is created as owner@localhost and the devices already
# paired stay signed in to *that* address, which is then only fixable by editing
# data/users.sqlite by hand. Ignored on every later start.
OWNER_EMAIL=you@example.com
