# ---- macOS ----
.DS_Store

# ---- Secrets ----
# Real secrets live only in local .env files (never committed).
.env
*.env
!*.env.example

# ---- Node / SMS Sync Server (Server App) ----
# Scoped to the server: a bare `data/` also swallowed the watch app's
# `.../tnwatch/data/` source package, so those files were silently untracked.
node_modules/
dist/
/Server App/data/
*.log

# ---- Go / GmBridge ----
# Generated xcframework (56 MB). Rebuild with Mac App/Scripts/build-gmbridge.sh
# (requires Go 1.25+). See that script for the pinned protocol commit.
GmBridge/build/

# ---- Xcode / Swift (Mac App) ----
