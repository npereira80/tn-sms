<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Cold-start splash. Without this the watch shows a black screen for a couple
      of seconds while the process starts and the database opens. The system
      splash can only show a background + icon (no text), so the app draws a
      matching "Loading…" screen immediately afterwards.
    -->
    <style name="Theme.TnWatch.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@android:color/black</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@android:style/Theme.DeviceDefault</item>
    </style>
</resources>
