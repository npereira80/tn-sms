<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  LaunchAgent for the SMS sync server. This is a TEMPLATE: __SERVER_DIR__ and
  __HOME__ are filled in by deploy/install-launchd.sh. Runs `npm start`
  (node dist/index.js) at login and restarts it if it exits.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.tnsms.server</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-lc</string>
        <string>cd "__SERVER_DIR__" &amp;&amp; exec npm start</string>
    </array>
    <key>WorkingDirectory</key>
    <string>__SERVER_DIR__</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>10</integer>
    <key>ProcessType</key>
    <string>Background</string>
    <key>StandardOutPath</key>
    <string>__HOME__/Library/Logs/tnsms-server.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/tnsms-server.log</string>
</dict>
</plist>
